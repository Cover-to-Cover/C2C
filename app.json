{
  "expo": {
    "name": "cover-to-cover-web",
    "slug": "cover-to-cover-web",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/c2c_logo.png",
    "scheme": "covertocoverweb",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/c2c_logo.png",
      "assetPrefix": "/"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
